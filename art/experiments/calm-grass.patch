+  const BASE = [hex('#4fa83d'), hex('#5cba4a')] as const;
+  const tone = (rgb: RGB, f: number): RGBA => c15(f <= 1 ? [rgb[0] * f, rgb[1] * f, rgb[2] * f] : [rgb[0] + (255 - rgb[0]) * (f - 1) * 1.6, rgb[1] + (255 - rgb[1]) * (f - 1) * 1.6, rgb[2] + (255 - rgb[2]) * (f - 1) * 1.6]);
+  const SLOPE = [0.5, 0.68, 0.84, 1, 1.14];
