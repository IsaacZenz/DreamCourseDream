+// ---------------------------------------------------------------------------
+// EXPERIMENT (calm grass D in the game, owner 2026-11-23). Not to be committed.
+if (process.env.GRASS_CALM) {
+  // Today's two checker greens as the base; everything else is a small step of lightness from them.
+  const BASE = [hex('#4fa83d'), hex('#5cba4a')] as const;
+  const tone = (rgb: RGB, f: number): RGBA => c15(f <= 1 ? [rgb[0] * f, rgb[1] * f, rgb[2] * f] : [rgb[0] + (255 - rgb[0]) * (f - 1) * 1.6, rgb[1] + (255 - rgb[1]) * (f - 1) * 1.6, rgb[2] + (255 - rgb[2]) * (f - 1) * 1.6]);
+  const SLOPE = [0.5, 0.68, 0.84, 1, 1.14];
+  const MEADOW: Record<string, number> = { a: 0.9, b: 0.95, n: 1, c: 1.04 };
+  const FLOWER = [c15(hex('#e8d070')), c15(hex('#e8a0c0'))];
+  const designs: Array<[string, number]> = [['plain', 0], ['plain', 1], ['blades', 0], ['blades', 1], ['blades', 2], ['dark', 0], ['dark', 1], ['light', 0], ['light', 1], ['flowers', 0], ['flowers', 1]];
+  const draw = (shape: ShapeId, odd: boolean, kind: string, seedN: number, meadow: string): Image => {
+    const rel = [...shape].map(Number);
+    const tris = triangles(shape).map((tri) => ({ pts: tri.map((i) => cornerScreen(i, rel[i]!)) as P[], shade: triShade(rel, tri) }));
+    const outline = [0, 1, 2, 3].map((i) => cornerScreen(i, rel[i]!));
+    const img = new Image(TILE_W, TILE_H);
+    const seed = (k: number) => hash(seedN * 17 + kind.length, k, 99);
+    for (let y = 0; y < TILE_H; y++)
+      for (let x = 0; x < TILE_W; x++) {
+        const t = tris.find((tr) => insideTri(x + BIAS_X, y + BIAS_Y, tr.pts[0]!, tr.pts[1]!, tr.pts[2]!));
+        if (!t) continue;
+        let shade = t.shade;
+        if (!insidePoly(x + BIAS_X, y + 1 + BIAS_Y, outline)) shade -= 1;
+        let f = SLOPE[Math.max(0, Math.min(4, shade))]! * MEADOW[meadow]!;
+        if (kind === 'plain' && hash(x, y, 5 + seedN) < 0.01) f *= 1.1;
+        if (kind === 'blades')
+          for (let k = 0; k < 3; k++) {
+            const bx = 6 + Math.floor(seed(20 + k) * 20);
+            const by = 6 + Math.floor(seed(30 + k) * 8);
+            if ((x === bx && y === by) || (x === bx + 2 && y === by + 1)) f *= 1.14;
+            if ((x === bx && y === by + 1) || (x === bx + 2 && y === by + 2)) f *= 0.84;
+          }
+        if (kind === 'dark' || kind === 'light') {
+          const cx = 10 + seed(40) * 12;
+          const cy = 9 + seed(41) * 4;
+          if (((x - cx) / 8) ** 2 + ((y - cy) / 3.5) ** 2 < 1) f *= kind === 'dark' ? 0.91 : 1.05;
+        }
+        // Shadow lines (owner, 2026-11-23): short darker strokes, like the shadows between blades.
+        // Their layout changes with the design, the checker and the meadow level.
+        if (process.env.GRASS_LINES) {
+          const ls = (k: number) => hash(seedN * 31 + kind.length * 7 + (odd ? 3 : 0) + meadow.charCodeAt(0), k, 123);
+          for (let k = 0; k < Number(process.env.GRASS_LINES); k++) {
+            const lx = 4 + Math.floor(ls(k) * 24);
+            const ly = 6 + Math.floor(ls(k + 50) * 10);
+            const form = Math.floor(ls(k + 100) * 3);
+            // | a short upright stroke, / a slanted one, v a little tuft of two strokes
+            const hit = form === 0 ? x === lx && (y === ly || y === ly + 1) : form === 1 ? (x === lx && y === ly + 1) || (x === lx + 1 && y === ly) : (x === lx && y === ly) || (x === lx + 1 && y === ly + 1) || (x === lx + 2 && y === ly);
+            if (hit) f *= 0.84;
+          }
+        }
+        let colour: RGBA | null = null;
+        if (kind === 'flowers')
+          for (let k = 0; k < 2; k++) {
+            const fx = 7 + Math.floor(seed(50 + k) * 18);
+            const fy = 6 + Math.floor(seed(60 + k) * 8);
+            if (x === fx && y === fy) colour = FLOWER[k]!;
+            if (x === fx && y === fy + 1) f *= 0.88;
+          }
+        img.set(x, y, colour ?? tone(BASE[odd ? 1 : 0], f));
+      }
+    return img;
+  };
+  const imgs: Image[] = [];
+  const names: string[] = [];
+  for (const m of Object.keys(MEADOW))
+    designs.forEach(([kind, n], k) => {
+      for (const odd of [false, true])
+        for (const s of SHAPES) {
+          imgs.push(draw(s, odd, kind, n, m));
+          names.push(`${s}${odd ? 'b' : ''}~g${k}${m}`);
+        }
+    });
+  for (const odd of [false, true])
+    for (const s of SHAPES) {
+      imgs.push(draw(s, odd, 'plain', 0, 'n'));
+      names.push(`${s}${odd ? 'b' : ''}`);
+    }
+  const cols = 32;
+  const grid = new Image(cols * TILE_W, Math.ceil(imgs.length / cols) * TILE_H);
+  imgs.forEach((im, i) => grid.blit(im, (i % cols) * TILE_W, Math.floor(i / cols) * TILE_H));
+  emit('tile-grass', grid, TILE_W, TILE_H, names, TILE_ANCHOR);
+  const man = JSON.parse((await import('node:fs')).readFileSync(join(OUT, 'manifest.json'), 'utf8')) as Manifest;
+  writeFileSync(join(OUT, 'manifest.json'), JSON.stringify({ ...man, sprites: { ...man.sprites, 'tile-grass': sprites['tile-grass'] } }, null, 2) + '\n');
+  const used = new Set<string>();
+  for (let i = 0; i < grid.data.length; i += 4) if (grid.data[i + 3]) used.add(`${grid.data[i]},${grid.data[i + 1]},${grid.data[i + 2]}`);
+  console.log(`EXPERIMENT: calm tile-grass, ${names.length} frames, ${used.size} colours`);
+}
