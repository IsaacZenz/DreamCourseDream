+// EXPERIMENT (calm grass D, 2026-11-23). Not to be committed.
+function gh(x: number, y: number, salt: number): number {
+  let h = (x * 374761393 + y * 668265263 + salt * 2246822519) | 0;
+  h = Math.imul(h ^ (h >>> 13), 1274126177);
+  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
+}
+function gnoise(x: number, y: number, size: number): number {
+  const fx = x / size, fy = y / size, x0 = Math.floor(fx), y0 = Math.floor(fy), sx = fx - x0, sy = fy - y0;
+  const s = (t: number) => t * t * (3 - 2 * t);
+  const a = gh(x0, y0, 7), b = gh(x0 + 1, y0, 7), c = gh(x0, y0 + 1, 7), d = gh(x0 + 1, y0 + 1, 7);
+  return a + (b - a) * s(sx) + (c - a) * s(sy) + (a - b - c + d) * s(sx) * s(sy);
+}
+const GRASS_DESIGNS: Array<[string, number]> = [['plain', 22], ['plain', 23], ['blades', 9], ['blades', 8], ['blades', 8], ['dark', 6], ['dark', 6], ['light', 6], ['light', 6], ['flowers', 3], ['flowers', 3]];
+function grassD(x: number, y: number): string {
+  const n = gnoise(x, y, 5);
+  // Four gentle steps from darker to lighter meadow, so patch edges fade over several tiles.
+  const m = n < 0.28 ? 'a' : n < 0.42 ? 'b' : n > 0.68 ? 'c' : 'n';
+  const dark = m === 'a' || m === 'b';
+  const bias: Record<string, number> = dark ? { plain: 1, blades: 1.8, dark: 2, light: 0.4, flowers: 0.5 } : m === 'c' ? { plain: 1, blades: 0.7, dark: 0.3, light: 2, flowers: 2.5 } : { plain: 1, blades: 1, dark: 1, light: 1, flowers: 1 };
+  const w = GRASS_DESIGNS.map(([k, v]) => v * bias[k]!);
+  let r = gh(x, y, 11) * w.reduce((a, b) => a + b, 0);
+  let k = 0;
+  for (; k < w.length - 1; k++) { r -= w[k]!; if (r < 0) break; }
+  return `~g${k}${m}`;
+}
