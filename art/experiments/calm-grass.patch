+        }
+        let colour: RGBA | null = null;
+        if (kind === 'flowers')
+          for (let k = 0; k < 2; k++) {
+            const fx = 7 + Math.floor(seed(50 + k) * 18);
+            const fy = 6 + Math.floor(seed(60 + k) * 8);
+            if (x === fx && y === fy) colour = FLOWER[k]!;
+            if (x === fx && y === fy + 1) f *= 0.88;
